{
	"schemaVersion": 1,
	"id": "multimedia",
	"version": "${version}",
	"name": "Sharing Craft",
	"description": "Free screen sharing, webcams above heads, floating screens and YouTube in Minecraft - Windows and Linux, client-side only. Based on MultiMedia by Schmodas (MIT).",
	"authors": ["dailytakeoff"],
	"contributors": ["Schmodas (original MultiMedia mod)"],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/dailytakeoff/multimedia",
		"sources": "https://github.com/dailytakeoff/multimedia"
	},
	"icon": "assets/multimedia/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["de.schmodas.multimedia.MultiMediaClient"],
		"modmenu": ["de.schmodas.multimedia.ModMenuIntegration"]
	},
	"mixins": [
		{ "config": "multimedia.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {
		"discstream": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
